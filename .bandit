# Bandit static-analysis configuration.
#
# B608 (hardcoded_sql_expressions) is intentionally waived for this codebase:
# every flagged query is assembled by BatchRuleCompiler or BoundaryLedger from
# *schema-validated* identifiers that are quoted via _quote_identifier(), or
# from module-level constant table/column names. No user-controlled string is
# interpolated into SQL, and queries execute against a sandboxed in-memory
# DuckDB connection or the local SQLite ledger. See BatchRuleCompiler and
# BoundaryLedger for the reviewed construction sites.
skips:
  - B608
exclude_dirs:
  - tests
  - benchmarks
