# syntax=docker/dockerfile:1
#
# Image for the public Data Shell demo/playground (web/main.py).
#
# Intentionally separate from the hardened API image (./Dockerfile): the demo
# serves static HTML plus a few endpoints that shell out to the CLI, does not
# need the server entrypoint, and relies on process-local concurrency, capacity
# and rate-limit bounds documented in docs/OPERATIONS.md.
#
# Reproducibility mirrors the API image: runtime dependencies come exclusively
# from the hash-pinned requirements.lock, and the engine is built into a wheel
# in a throwaway builder stage using the hash-pinned build backend. Only `web/`
# is copied into the runtime stage, so `datashell` always resolves to the
# installed wheel rather than a checkout on PYTHONPATH. Runs as non-root.

# ---------------------------------------------------------------------------
# builder: build the wheel from the checkout with the pinned build backend
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_RETRIES=10 \
    PIP_DEFAULT_TIMEOUT=60 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

COPY requirements.lock requirements-build.lock ./
RUN python -m pip install --require-hashes -r requirements-build.lock

COPY pyproject.toml README.md ./
COPY datashell ./datashell
RUN python -m pip wheel --no-deps --no-build-isolation --wheel-dir /wheels .

# ---------------------------------------------------------------------------
# runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_RETRIES=10 \
    PIP_DEFAULT_TIMEOUT=60 \
    PORT=8000 \
    PYTHONPATH=/app \
    DATASHELL_STORAGE_ROOT=/app/storage \
    TMPDIR=/app/storage/tmp

RUN groupadd --system --gid 10001 datashell \
    && useradd --system --uid 10001 --gid datashell --home-dir /nonexistent --shell /usr/sbin/nologin datashell

WORKDIR /app

# Runtime dependencies: exactly the resolved, hash-verified release set.
COPY requirements.lock ./
RUN python -m pip install --require-hashes -r requirements.lock

# The engine wheel, installed without a second, unpinned resolution.
COPY --from=builder /wheels /tmp/wheels
RUN python -m pip install --no-deps /tmp/wheels/*.whl \
    && rm -rf /tmp/wheels

# Demo application source: templates, static assets and the FastAPI app. The
# engine itself is never copied — it comes from the installed wheel.
COPY web ./web

# Ephemeral in-container storage. Uploads are staged under TMPDIR and removed
# per request; delivered artifacts, quarantine records and audit certificates
# persist for the life of the container and are lost on redeploy.
RUN mkdir -p /app/storage/tmp /app/storage/output \
    && chown -R datashell:datashell /app/storage \
    && rm -rf /tmp/*

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)" || exit 1

# Proxy-header trust is explicit and fails safe: only loopback is trusted for
# X-Forwarded-For unless FORWARDED_ALLOW_IPS names the real proxy. With the
# wildcard default this value fed _client_identity() and a visitor could rotate
# X-Forwarded-For to bypass the per-client rate limit. The app also applies an
# identity-independent global ceiling (DATASHELL_DEMO_GLOBAL_RATE_LIMIT_*).
CMD ["sh", "-c", "exec uvicorn web.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS:-127.0.0.1}\" --workers 1"]
