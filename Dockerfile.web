# syntax=docker/dockerfile:1
#
# Image for the public Data Shell demo/playground (web/main.py).
#
# This is intentionally separate from the hardened API image (./Dockerfile):
# the demo serves static HTML plus two endpoints that shell out to the CLI, and
# does not need the server entrypoint or its security posture.
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    DATASHELL_STORAGE_ROOT=/app/storage \
    TMPDIR=/app/storage/tmp

WORKDIR /app

COPY pyproject.toml README.md ./
COPY datashell ./datashell
COPY web ./web

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir . \
    && mkdir -p /app/storage/tmp /app/storage/output \
    && rm -rf /root/.cache /tmp/*

EXPOSE 8000

CMD ["sh", "-c", "exec uvicorn web.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=\"*\" --workers 1"]
