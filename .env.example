# Data Shell — example environment configuration (placeholders only).
# Copy to `.env` (or inject via your secret manager) and replace every value.
# Never commit real secrets. Production refuses to start with placeholders,
# short values (<32 chars), or low-entropy secrets.
#
#   cp .env.example .env   # then edit .env (git-ignored)

# --- Deployment mode -------------------------------------------------------
# One of: development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Required secrets (production: explicit high-entropy values required) ---
DATASHELL_API_KEY=replace_with_secure_generated_api_key__min_32_chars
DATASHELL_HMAC_SECRET=replace_with_secure_generated_hmac_secret__min_32_chars
DATASHELL_KEY_ID=datashell-hmac-v1
# Previous signing secrets retained during rotation (JSON object, optional):
DATASHELL_HMAC_KEYRING={}

# --- Asymmetric audit-certificate signing (optional, recommended) -----------
# When set, certificates are Ed25519-signed (third-party verifiable with the
# public key only). Retain previous key IDs in DATASHELL_ED25519_KEYRING
# during rotation.
DATASHELL_ED25519_PRIVATE_KEY=
DATASHELL_ED25519_KEY_ID=datashell-ed25519-v1
DATASHELL_ED25519_KEYRING={}

# --- Browser / proxy trust (production: explicit values required) -----------
# Comma-separated list of exact HTTPS origins, e.g.
#   ALLOWED_ORIGINS=https://console.example.com
ALLOWED_ORIGINS=
# Explicit trusted proxy IPs/CIDRs — never `*` in production.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Storage ----------------------------------------------------------------
DATASHELL_STORAGE_ROOT=./output
DATASHELL_DATA_DIR=
DATASHELL_CONTRACTS_DIR=
DATASHELL_OUTPUT_DIR=
DATASHELL_AUDIT_DIR=
DATASHELL_QUARANTINE_DIR=
# Scratch for spooled uploads / DuckDB spills (point at durable volume):
DATASHELL_TMP_DIR=
TMPDIR=

# --- Resource limits ---------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=21474836480
MAX_REQUEST_BODY_BYTES=21475836416
MAX_CONTROL_BODY_BYTES=1048576
MAX_CONCURRENT_RUNS=2
MAX_CONCURRENT_REQUESTS=2
STREAM_AUTO_THRESHOLD_BYTES=67108864
STREAM_CHUNK_ROWS=100000
STREAM_CHUNK_CELL_BUDGET=1000000
DUCKDB_MEMORY_LIMIT=1GB
MIN_FREE_DISK_BYTES=21474836480
DATASHELL_DISK_HEADROOM_MULTIPLIER=2.0
DATASHELL_HISTORY_RETENTION_DAYS=0

# --- Drift detection ----------------------------------------------------------
DRIFT_ENABLED=false
DRIFT_BASELINE_WINDOW=5

# --- Webhooks / alerts / billing (optional) ----------------------------------
# Signed run.completed events (operational telemetry).
DATASHELL_RUN_WEBHOOK_URL=

# Actionable human alerts: pipeline failures, pending ledger entries, and
# publication-recovery errors. Use an HTTPS receiver in production; do not put
# credentials in the URL. The secret falls back to DATASHELL_HMAC_SECRET.
DATASHELL_ALERT_WEBHOOK_URL=
DATASHELL_ALERT_WEBHOOK_SECRET=
DATASHELL_ALERT_TIMEOUT_SECONDS=5
DATASHELL_ALERT_MAX_ATTEMPTS=3
DATASHELL_ALERT_BACKOFF_SECONDS=1

DATASHELL_BILLING_PROVIDER=dry-run
DATASHELL_BILLING_STRIPE_SECRET_KEY=
DATASHELL_BILLING_STRIPE_TEST_MODE=true

# --- Tracing (optional; needs the `datashell-engine[otel]` extra) --------------------
# Both halves are required: the endpoint expresses the intent, the extra
# provides the OpenTelemetry SDK and the OTLP/gRPC exporter. Without either
# one, the gateway is silent and nothing else changes.
OTEL_EXPORTER_OTLP_ENDPOINT=
DATASHELL_OTEL_SERVICE_NAME=datashell
